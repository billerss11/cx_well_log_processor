          },
          "null_count": {
            "title": "Null Count",
            "type": "integer"
          },
          "preview_samples": {
            "items": {
              "$ref": "#/components/schemas/LasPreviewSample"
            },
            "title": "Preview Samples",
            "type": "array"
          },
          "sample_count": {
            "title": "Sample Count",
            "type": "integer"
          },
          "unit": {
            "title": "Unit",
