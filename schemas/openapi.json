          "id",
          "mnemonic",
          "unit",
          "description",
          "minimum",
          "maximum",
          "sample_count",
          "null_count",
          "preview_samples"
        ],
        "title": "LasCurveSummary",
        "type": "object"
      },
      "LasImportRequest": {
        "additionalProperties": false,
        "properties": {
          "max_preview_points": {
            "default": 800,
            "maximum": 2000.0,
            "minimum": 100.0,
            "title": "Max Preview Points",
            "type": "integer"
          },
          "source_path": {
            "minLength": 1,
            "title": "Source Path",
            "type": "string"
          }
        },
        "required": [
          "source_path"
        ],
        "title": "LasImportRequest",
        "type": "object"
      },
