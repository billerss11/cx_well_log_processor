{
  "name": "@welllog/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "corepack pnpm build:electron && vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "dev": "corepack pnpm build:electron && cross-env NO_PROXY=127.0.0.1,localhost concurrently -k -n renderer,electron \"vite\" \"wait-on http://127.0.0.1:5174 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@welllog/arrow-data-client": "workspace:^",
    "@welllog/log-renderer": "workspace:*",
    "@welllog/ts-api-client": "workspace:*",
    "antd": "^6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^43.2.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.8.3",
    "vite": "^8.2.0",
    "vitest": "^4.0.0",
    "wait-on": "^9.0.0"
  }
}
